PORT=8000
PAPERLESS_SECRET_KEY=change-me-to-a-random-secret
PAPERLESS_REDIS=${{REDIS_URL}}
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=${{PGHOST}}
PAPERLESS_DBPORT=${{PGPORT}}
PAPERLESS_DBNAME=${{PGDATABASE}}
PAPERLESS_DBUSER=${{PGUSER}}
PAPERLESS_DBPASS=${{PGPASSWORD}}
PAPERLESS_DB_OPTIONS={"sslmode": "prefer"}
PAPERLESS_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=eng
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_POLLING_INTERVAL=0
PAPERLESS_TASK_CONSUMER_DIR=/usr/src/paperless/data
PAPERLESS_DATA_DIR=/usr/src/paperless/data
PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
PAPERLESS_CONSUMPTION_DIR=/usr/src/paperless/consume
PAPERLESS_EXPORT_DIR=/usr/src/paperless/export
PAPERLESS_API_TRANSPORT=requests
